# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Cached raw API responses — re-runs read these instead of re-fetching
cache/

# Generated run outputs (CSVs, reports). Keep these out of git; they are
# regenerated and reviewed each run.
output/
logs/

# never commit SMTP secrets (reused from the Zara parser's git-ignored email.ini)
config/*.ini

# headless-browser profile (may hold cookies) — never commit
config/reddit_profile/

# history/ (index_history.parquet) IS tracked on purpose — it is the trend store.

# refresh_500: keep the curated collection CSVs, HANDOFF and build scripts, but
# NOT the bulky raw per-brand pulls, run logs, backups, or transient caches.
# (These would only add ~1,100 scratch files and noise to the public repo; the
# site is built from the curated CSVs by dashboard.py.)
refresh_500/gdelt_csv/
refresh_500/wiki_csv/
refresh_500/*.log
refresh_500/*.bak_*
refresh_500/*_checkpoint.json
refresh_500/adidas_mom_cache.json
refresh_500/dashboard_refreshed.html
trends_out/
